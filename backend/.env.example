# ─────────────────────────────────────────────
#  SchemeSnap · Backend Environment Variables
#  Copy to .env and fill in your real values.
# ─────────────────────────────────────────────

# Google Gemini API keys (required; comma-separated for automatic quota fallback)
GEMINI_API_KEYS=your_first_gemini_api_key,your_second_gemini_api_key
# For a single key, GEMINI_API_KEY=your_gemini_api_key_here is also supported.

# Server port (optional, defaults to 3000)
PORT=3000
